+// FiveM Enhanced hands the game backbuffer to CEF with every row padded to 256 bytes, but CEF
+// reads it as tightly packed (width * 4). Whenever the width is not a multiple of 64 px (e.g.
+// 3024 or 3440) each row starts a little further along and the image turns into horizontal
+// stripes. Undo that here: find where the wanted pixel really sits in the padded memory and
+// sample that texel. u_pitch == u_size.x (1920, 2560, 3840) leaves the lookup untouched.
 const FRAGMENT_SHADER = `
+  precision highp float;
   varying highp vec2 v_texcoord;
   uniform sampler2D u_texture;
+  uniform vec2 u_size;
+  uniform float u_pitch;
   void main() {
-    gl_FragColor = texture2D(u_texture, v_texcoord);
+    vec2 uv = v_texcoord;
+    if (u_pitch > u_size.x) {
+      // The texture's v=0 row is the bottom of the image (it is drawn upright with v=0 at the
+      // bottom of the canvas), while the padding lives in memory order, top row first. Work in
+      // memory rows and flip back.
+      float x = floor(uv.x * u_size.x);
+      float memoryRow = u_size.y - 1.0 - floor(uv.y * u_size.y);
+      float linear = memoryRow * u_pitch + x;
+      float row = floor((linear + 0.5) / u_size.x);
+      float column = linear - row * u_size.x;
+      // The padded rows run out before the texture does: the bottom few rows repeat.
+      row = min(row, u_size.y - 1.0);
+      uv = vec2((column + 0.5) / u_size.x, (u_size.y - 1.0 - row + 0.5) / u_size.y);
+    }
+    gl_FragColor = texture2D(u_texture, uv);
   }
 `
 
+/** Row length, in pixels, of the padded buffer FiveM Enhanced shares (256-byte rows). */
+export function paddedRowPixels(width: number): number {
+  return Math.ceil((width * 4) / 256) * 64
+}
