root = true

[*]
indent_size = 4
indent_style = tab
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
charset = utf-8
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = false
